{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "corvo-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"preview_urls": false,
	"vars": {
		// Origens permitidas no CORS (separadas por vírgula). Não é segredo.
		"ALLOWED_ORIGINS": "http://localhost:5173,https://corvo-web.henriquesouza.workers.dev",
		// Repositório cujo workflow "collect.yml" o Cron Trigger aciona. Não é segredo.
		"GITHUB_REPO": "henriquesouza1832001-eng/Corvo",
		// Banco: D1 (cloudflare) + KV. O Oracle é a base; o D1 recebe só o que o painel mostra. Para usar o Turso de novo, defina DB_BACKEND=turso.
		"DB_BACKEND": "d1"
	},
	// A cada 5 min a Cloudflare aciona a coleta (mais pontual que o agendador do GitHub).
	"triggers": { "crons": [] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "corvo",
			"database_id": "8576fa1d-aee4-485d-a5a1-0064c9b0dc3f",
			"migrations_dir": "../../database/migrations"
		}
	],
	"kv_namespaces": [{ "binding": "KV", "id": "9547445c745042fca6f71aa758f4629a" }],
	// Segredos (via `wrangler secret put`, nunca no Git): INGEST_TOKEN (o Oracle usa este para empurrar dados), ADMIN_TOKEN
}
