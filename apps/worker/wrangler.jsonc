{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "corvo-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"preview_urls": false,
	"vars": {
		// Origens permitidas no CORS (separadas por vírgula). Não é segredo.
		"ALLOWED_ORIGINS": "http://localhost:5173,https://corvo-web.henriquesouza.workers.dev",
		// Repositório cujo workflow "collect.yml" o Cron Trigger aciona. Não é segredo.
		"GITHUB_REPO": "henriquesouza1832001-eng/Corvo",
		// Banco: Turso (segredos TURSO_URL e TURSO_TOKEN). O KV abaixo é só cache do feed (60 s), não guarda dado de verdade.
		"DB_BACKEND": "turso",
		// Teto diário de linhas (Turso grátis: ~10 mi/mês). Ajuste depois de ver o consumo real.
		"DAILY_WRITE_LIMIT": "300000"
	},
	// Sem Cron: a coleta roda no Oracle (docs/corvo/ARQUITETURA.md).
	"triggers": { "crons": [] },
	"kv_namespaces": [{ "binding": "KV", "id": "9547445c745042fca6f71aa758f4629a" }],
	// Segredos (via `wrangler secret put`, nunca no Git): INGEST_TOKEN (o Oracle usa este para empurrar dados), ADMIN_TOKEN
}
