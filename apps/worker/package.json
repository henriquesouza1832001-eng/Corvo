{
  "name": "@corvo/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc -p .",
    "test": "vitest run --passWithNoTests",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply corvo --local",
    "db:seed": "wrangler d1 execute corvo --local --file ../../database/seeds/dev.sql"
  },
  "dependencies": {
    "@corvo/shared": "*",
    "hono": "^4.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.40.0"
  }
}
